{
  "manifest_version": 3,
  "name": "Ecode",
  "version": "1.0.0",
  "description": "将当前页面 URL 生成二维码，支持自定义内容生成二维码",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"]
}
